          "sets": 3,
          "target_reps": "10-12",
          "target_rpe": 8,
          "rest_seconds": 90
        },
        {
          "order": 4,
          "exercise_id": "farmers_walk",
          "substitution_group": "carry_conditioning",
          "sets": 3,
          "target_reps": "40 meters",
          "rest_seconds": 60,
